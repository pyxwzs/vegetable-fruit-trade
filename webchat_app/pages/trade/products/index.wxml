<view class="product-page">
  <view class="summary-card">
    <view class="summary-head">
      <text class="summary-title">商品概览</text>
      <view class="add-btn" bindtap="openCreate">+ 新增</view>
    </view>
    <view class="summary-metrics">
      <view class="metric-item">
        <text class="metric-label">商品总数</text>
        <text class="metric-value accent">{{ totalCount }}</text>
      </view>
      <view class="metric-divider" />
      <view class="metric-item">
        <text class="metric-label">启用中</text>
        <text class="metric-value green">{{ enabledCount }}</text>
      </view>
    </view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{ keyword }}"
        placeholder="搜索名称/分类"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchSubmit"
      />
      <text wx:if="{{ keyword }}" class="search-clear" bindtap="onSearchClear">×</text>
    </view>
    <picker
      mode="selector"
      range="{{ filters }}"
      range-key="label"
      value="{{ filterIndex }}"
      bindchange="onFilterChange"
    >
      <view class="filter-select">
        <text>{{ filters[filterIndex].label }}</text>
        <text class="filter-arrow">▾</text>
      </view>
    </picker>
  </view>

  <view wx:if="{{ loading && !list.length }}" class="state-box">
    <t-loading theme="circular" size="48rpx" />
  </view>

  <view wx:elif="{{ !list.length }}" class="state-box">
    <t-empty icon="catalog" description="暂无商品" />
  </view>

  <view wx:else class="card-list">
    <view wx:for="{{ list }}" wx:key="id" class="product-card">
      <view class="card-head">
        <view class="head-main">
          <view class="product-name">{{ item.name }}</view>
          <view class="product-meta">{{ item.category }}</view>
        </view>
        <view class="head-right">
          <t-tag theme="{{ item.statusTheme }}" variant="light" size="small">{{ item.statusText }}</t-tag>
        </view>
      </view>

      <view class="card-rows">
        <view class="info-row">
          <text class="k">规格/单位</text>
          <text class="v">{{ item.specUnit }}</text>
        </view>
      </view>

      <view class="card-actions" catchtap="stopBubble">
        <t-button
          size="small"
          theme="primary"
          variant="outline"
          data-id="{{ item.id }}"
          catchtap="openEdit"
        >编辑</t-button>
        <t-button
          size="small"
          theme="danger"
          variant="outline"
          data-id="{{ item.id }}"
          data-name="{{ item.name }}"
          catchtap="onDelete"
        >删除</t-button>
      </view>
    </view>

    <view class="pagination" wx:if="{{ total > 0 }}">
      <text class="pg-total">共 {{ total }} 条</text>
      <picker
        mode="selector"
        range="{{ pageSizeOptions }}"
        value="{{ pageSizeIndex }}"
        bindchange="onPageSizeChange"
      >
        <view class="pg-size">{{ pageSize }} 条/页 ▾</view>
      </picker>
      <view class="pg-nav">
        <view class="pg-btn {{ page <= 1 ? 'disabled' : '' }}" bindtap="onPrevPage">上一页</view>
        <text class="pg-info">{{ page }}/{{ totalPages }}</text>
        <view class="pg-btn {{ page >= totalPages ? 'disabled' : '' }}" bindtap="onNextPage">下一页</view>
      </view>
    </view>
  </view>
</view>

<t-popup visible="{{ showForm }}" placement="bottom" bind:visible-change="closeForm">
  <view class="form-panel">
    <view class="form-title">{{ formMode === 'edit' ? '编辑商品' : '新增商品' }}</view>
    <view class="form-field">
      <text class="form-label">商品名称</text>
      <input class="form-input" value="{{ form.name }}" data-field="name" placeholder="必填" bindinput="onFormField" />
    </view>
    <view class="form-field">
      <text class="form-label">分类</text>
      <input
        class="form-input"
        value="{{ form.category }}"
        data-field="category"
        placeholder="{{ categorySuggestions.length ? '可点选下方分类或手动输入' : '请输入分类' }}"
        bindinput="onFormField"
      />
      <view wx:if="{{ categorySuggestions.length }}" class="category-chips">
        <view
          wx:for="{{ categorySuggestions }}"
          wx:key="*this"
          class="category-chip {{ form.category === item ? 'active' : '' }}"
          data-value="{{ item }}"
          bindtap="onPickCategory"
        >{{ item }}</view>
      </view>
    </view>
    <view class="form-field">
      <text class="form-label">单位</text>
      <input class="form-input" value="{{ form.unit }}" data-field="unit" placeholder="如：斤、箱" bindinput="onFormField" />
    </view>
    <view class="form-field">
      <text class="form-label">规格</text>
      <input class="form-input" value="{{ form.specification }}" data-field="specification" placeholder="选填" bindinput="onFormField" />
    </view>
    <view class="form-field">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{ statusOptions }}" range-key="label" value="{{ statusIndex }}" bindchange="onStatusChange">
        <view class="form-picker">{{ statusOptions[statusIndex].label }} ▾</view>
      </picker>
    </view>
    <t-button theme="primary" block loading="{{ submitting }}" bindtap="submitForm">
      {{ formMode === 'edit' ? '保存' : '新增' }}
    </t-button>
  </view>
</t-popup>
