<view class="profile-page">
  <view wx:if="{{ avatarUrl }}" class="avatar-wrap">
    <image class="avatar" src="{{ avatarUrl }}" mode="aspectFill" />
  </view>
  <t-input wx:if="{{ form.wxNickname }}" label="微信昵称" value="{{ form.wxNickname }}" disabled />
  <t-input label="姓名" placeholder="选填" value="{{ form.realName }}" data-field="realName" bindchange="onFieldChange" />
  <t-input label="手机号" placeholder="选填" value="{{ form.phone }}" data-field="phone" bindchange="onFieldChange" />
  <view class="actions">
    <t-button theme="primary" block loading="{{ loading }}" bindtap="onSave">保存</t-button>
  </view>
</view>
