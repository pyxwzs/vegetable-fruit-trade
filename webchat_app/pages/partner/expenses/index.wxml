<wxs src="../../../utils/format.wxs" module="f" />
<view class="expense-page">
  <view class="summary-card">
    <view class="summary-head">
      <text class="summary-title">支出统计</text>
      <view class="add-btn" bindtap="openCreate">+ 新增</view>
    </view>

    <view class="date-query orange inline">
      <view class="mode-tabs">
        <view class="mode-tab {{ dateMode === 'day' ? 'active' : '' }}" data-mode="day" bindtap="onDateModeChange">按日</view>
        <view class="mode-tab {{ dateMode === 'month' ? 'active' : '' }}" data-mode="month" bindtap="onDateModeChange">按月</view>
        <view class="mode-tab {{ dateMode === 'year' ? 'active' : '' }}" data-mode="year" bindtap="onDateModeChange">按年</view>
      </view>
      <picker wx:if="{{ dateMode === 'day' }}" mode="date" value="{{ selectedDate }}" bindchange="onDatePickChange">
        <view class="date-picker">{{ selectedDate }} ▾</view>
      </picker>
      <picker wx:elif="{{ dateMode === 'month' }}" mode="date" fields="month" value="{{ selectedMonth }}" bindchange="onDatePickChange">
        <view class="date-picker">{{ selectedMonth }} ▾</view>
      </picker>
      <picker wx:else mode="date" fields="year" value="{{ selectedYear }}" bindchange="onDatePickChange">
        <view class="date-picker">{{ selectedYear }}年 ▾</view>
      </picker>
      <view class="date-range-label">查询范围：{{ dateLabel }}</view>
    </view>

    <view class="summary-metrics">
      <view class="metric-item">
        <text class="metric-label">{{ periodPrefix }}支出</text>
        <text class="metric-value orange">¥{{ periodAmountText }}</text>
        <text class="metric-sub">{{ periodCount }} 笔</text>
      </view>
    </view>

    <view wx:if="{{ periodSummary.items.length }}" class="category-breakdown">
      <view class="breakdown-title">分类占比</view>
      <view wx:for="{{ periodSummary.items }}" wx:key="category" class="breakdown-row">
        <text class="breakdown-name">{{ item.category }}</text>
        <view class="breakdown-bar-wrap">
          <view class="breakdown-bar" style="width: {{ item.barWidth }}%;" />
        </view>
        <view class="breakdown-right">
          <text class="breakdown-percent">{{ item.percentText }}</text>
          <text class="breakdown-amount">¥{{ f.fmtMoney(item.amount) }}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{ keyword }}"
        placeholder="搜索分类"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchSubmit"
      />
      <text wx:if="{{ keyword }}" class="search-clear" bindtap="onSearchClear">×</text>
    </view>
  </view>

  <view wx:if="{{ loading && !list.length }}" class="state-box">
    <t-loading theme="circular" size="48rpx" />
  </view>

  <view wx:elif="{{ !list.length }}" class="state-box">
    <t-empty icon="money" description="暂无支出记录" />
  </view>

  <view wx:else class="card-list">
    <view wx:for="{{ list }}" wx:key="id" class="expense-card">
      <view class="card-head">
        <view class="head-main">
          <view class="expense-category">{{ item.category }}</view>
          <view class="expense-date">{{ item.expenseDate }}</view>
        </view>
        <view class="head-right">
          <view class="expense-amount">¥{{ f.fmtMoney(item.amount) }}</view>
        </view>
      </view>

      <view class="card-actions" catchtap="stopBubble">
        <t-button
          size="small"
          theme="primary"
          variant="outline"
          data-id="{{ item.id }}"
          catchtap="openEdit"
        >编辑</t-button>
        <t-button
          size="small"
          theme="danger"
          variant="outline"
          data-id="{{ item.id }}"
          data-category="{{ item.category }}"
          data-amount="{{ f.fmtMoney(item.amount) }}"
          catchtap="onDelete"
        >删除</t-button>
      </view>
    </view>

    <view class="pagination" wx:if="{{ total > 0 }}">
      <text class="pg-total">共 {{ total }} 条</text>
      <picker
        mode="selector"
        range="{{ pageSizeOptions }}"
        value="{{ pageSizeIndex }}"
        bindchange="onPageSizeChange"
      >
        <view class="pg-size">{{ pageSize }} 条/页 ▾</view>
      </picker>
      <view class="pg-nav">
        <view class="pg-btn {{ page <= 1 ? 'disabled' : '' }}" bindtap="onPrevPage">上一页</view>
        <text class="pg-info">{{ page }}/{{ totalPages }}</text>
        <view class="pg-btn {{ page >= totalPages ? 'disabled' : '' }}" bindtap="onNextPage">下一页</view>
      </view>
    </view>
  </view>
</view>

<t-popup visible="{{ showForm }}" placement="bottom" bind:visible-change="closeForm">
  <view class="form-panel">
    <view class="form-title">{{ formMode === 'edit' ? '编辑支出' : '新增支出' }}</view>
    <view class="form-field">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{ form.expenseDate }}" bindchange="onFormDateChange">
        <view class="form-picker">{{ form.expenseDate || '请选择' }} ▾</view>
      </picker>
    </view>
    <view class="form-field">
      <text class="form-label">分类</text>
      <input
        class="form-input"
        value="{{ form.category }}"
        data-field="category"
        placeholder="{{ categorySuggestions.length ? '可点选下方分类或手动输入' : '请输入分类名称' }}"
        bindinput="onFormField"
      />
      <view wx:if="{{ categorySuggestions.length }}" class="category-chips">
        <view
          wx:for="{{ categorySuggestions }}"
          wx:key="*this"
          class="category-chip {{ form.category === item ? 'active' : '' }}"
          data-value="{{ item }}"
          bindtap="onPickCategory"
        >{{ item }}</view>
      </view>
    </view>
    <view class="form-field">
      <text class="form-label">金额（元）</text>
      <input
        class="form-input"
        value="{{ form.amount }}"
        data-field="amount"
        type="digit"
        placeholder="必填，大于 0"
        bindinput="onFormField"
      />
    </view>
    <t-button theme="primary" block loading="{{ submitting }}" bindtap="submitForm">
      {{ formMode === 'edit' ? '保存' : '新增' }}
    </t-button>
  </view>
</t-popup>
