# =============================================================================
# 生产环境配置（Docker 部署）
# =============================================================================
# cp .env.example .env  →  填写下方占位项  →  docker compose up -d
#
# 部署前：
#   cd backend && ./mvnw clean package -DskipTests
#   cp backend/target/vegetable-fruit-trade-1.0.0.jar .
#   docker network create fnos    # 首次，MySQL 与 backend 须在同一网络
#
# 本地开发勿用本文件，请改 backend/src/main/resources/application.yml
# =============================================================================

# ── 后端 ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080

# ── MySQL（Docker 网络内服务名，如 database/docker-compose 的 trade-mysql）──
MYSQL_HOST=trade-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=trade_db
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD

# ── JWT（必填，随机长字符串，勿用默认值）────────────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS

# ── 微信小程序（必填，微信公众平台 → 开发设置）──────────────────────────────
WECHAT_MINI_PROGRAM_APP_ID=your-mini-program-app-id
WECHAT_MINI_PROGRAM_APP_SECRET=your-mini-program-app-secret
WECHAT_MINI_PROGRAM_MOCK_ENABLED=false

# 容器内上传目录（compose 已挂载 ./uploads → /app/uploads）
APP_UPLOAD_DIR=uploads

# ── 运行 ─────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 可选：JWT 过期时间（毫秒，一般保持默认即可）────────────────────────────
# JWT_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000
# JWT_REFRESH_EXPIRATION_REMEMBER=2592000000

# ── 其它组件（不在此 .env 读取，部署时单独配置）────────────────────────────
# 小程序 API 域名：webchat_app/config.js → baseUrl 改为 https://api.example.com/api
# Web 前端反代：frontend/.env.production → VUE_APP_BASE_API=/api
